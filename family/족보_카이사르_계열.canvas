  },
  {
   "id": "90e07ca7503dd92a",
   "type": "text",
   "x": 195,
   "y": 2120,
   "width": 230,
   "height": 104,
   "text": "VI-3  **[[아그리피나(클라우디우스의 아내)]]**\n15~59",
