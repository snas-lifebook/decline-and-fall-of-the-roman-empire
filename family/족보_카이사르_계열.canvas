   "type": "text",
   "x": 0,
   "y": 848,
   "width": 230,
   "height": 104,
   "text": "III-3  **[[리비아 드루실라]]**\n기원전 58~29",
   "color": "6"
  },
  {
   "id": "e547d8f4402a78a7",
   "type": "text",
   "x": 390,
   "y": 848,
   "width": 230,
   "height": 104,
   "text": "III-4  **[[스크리보니아]]**",
   "color": "6"
  },
  {
   "id": "076ee1d7f033c5e1",
   "type": "text",
   "x": -780,
   "y": 1272,
   "width": 230,
   "height": 104,
